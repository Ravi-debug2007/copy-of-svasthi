# Optional URL for a separate local Svasthi API. Leave unset on Vercel so the
# frontend uses its same-origin serverless routes.
VITE_SVASTHI_API_URL="http://localhost:3001"

# Add this only in Vercel's Environment Variables settings, never in a VITE_
# variable or source file. Create it in Google AI Studio.
GEMINI_API_KEY=""
